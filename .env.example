# ---- 数据 ----
# 默认写到仓库根目录的 data/，不要提交。
DATA_DIR=./data
DATABASE_PATH=./data/ai-girl.db

# ---- 监听地址 ----
# 只影响 python -m app / npm run dev:api；npm run dev 脚本默认就用 0.0.0.0。
# 127.0.0.1 仅本机可访问；0.0.0.0 允许手机 / 局域网设备访问（注意安全提示）。
HOST=127.0.0.1
PORT=5190

# ---- 账号 ----
# 首次启动时创建；已有同名账号时不会改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
DEMO_USER_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234

SESSION_DAYS=30
COOKIE_SECURE=false
# 前后端同源（Vite 代理或后端静态托管）时留空；跨域直连时才填前端 origin。
PUBLIC_ORIGIN=

# ---- 文本模型（OpenAI Chat Completions 兼容网关）----
# 不填 LLM_API_KEY 时自动进入本地演示模式，UI、工具、记忆仍然可用。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# 模型必须支持图片输入，用户发照片才能被看见。
LLM_VISION=true
LLM_TIMEOUT=120

# ---- 自拍 / 语音（可选，OpenAI 兼容接口）----
# 未配置时工具返回“暂不可用”，文字聊天不受影响。
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536

TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ---- 上限 ----
MAX_UPLOAD_MB=8
MAX_CONTEXT_MESSAGES=48
MAX_TOOL_ROUNDS=6
RATE_LIMIT_PER_MINUTE=24
